<?xml version="1.0" encoding="utf-8" ?>

<odoo noupdate="1">
    <record
        id="stock_barcodes_option_group_remove_inventory"
        model="stock.barcodes.option.group"
    >
        <field name="accumulate_read_quantity">False</field>
        <field name="allow_direct_partial_delivery">True</field>
        <field name="allow_negative_quant">True</field>
        <field name="auto_lot">False</field>
        <field name="auto_put_in_pack">False</field>
        <field name="barcode_guided_mode">False</field>
        <field name="code">INV</field>
        <field name="confirmed_moves">False</field>
        <field name="create_lot">False</field>
        <field name="display_name">Remove options</field>
        <field name="display_notification">False</field>
        <field name="display_read_quant">True</field>
        <field name="fill_fields_from_lot">False</field>
        <field name="group_key_for_todo_records">False</field>
        <field name="ignore_filled_fields">False</field>
        <field name="ignore_quant_location">False</field>
        <field name="is_manual_confirm">False</field>
        <field name="is_manual_qty">False</field>
        <field name="keep_screen_values">False</field>
        <field name="location_field_to_sort">location_dest_id</field>
        <field name="manual_entry">True</field>
        <field name="manual_entry_field_focus">location_id</field>
        <field name="name">Remove options</field>
        <field name="show_all_quantities">False</field>
        <field name="show_detailed_operations">True</field>
        <field name="show_owner">False</field>
        <field name="show_pending_moves">True</field>
        <field name="show_stock">True</field>
        <field name="source_pending_moves">move_ids</field>
        <field name="use_location_dest_putaway">False</field>
    </record>

    <record
        id="stock_barcodes_option_location_id_remove_inventory"
        model="stock.barcodes.option"
    >
        <field name="name">Location</field>
        <field name="step">1</field>
        <field name="sequence">10</field>
        <field name="field_name">location_id</field>
        <field name="filled_default">True</field>
        <field name="forced">False</field>
        <field name="to_scan">False</field>
        <field name="required">True</field>
        <field name="clean_after_done">False</field>
        <field
            name="option_group_id"
            ref="stock_barcodes.stock_barcodes_option_group_remove_inventory"
        />
    </record>

    <record
        id="stock_barcodes_option_product_id_remove_inventory"
        model="stock.barcodes.option"
    >
        <field name="name">Product</field>
        <field name="step">2</field>
        <field name="sequence">20</field>
        <field name="field_name">product_id</field>
        <field name="filled_default">False</field>
        <field name="forced">False</field>
        <field name="to_scan">True</field>
        <field name="required">True</field>
        <field name="clean_after_done">True</field>
        <field
            name="option_group_id"
            ref="stock_barcodes.stock_barcodes_option_group_remove_inventory"
        />
    </record>

    <record id="stock_barcodes_option_lot_id_remove_inventory" model="stock.barcodes.option">
        <field name="name">Lot</field>
        <field name="step">2</field>
        <field name="sequence">30</field>
        <field name="field_name">lot_id</field>
        <field name="filled_default">False</field>
        <field name="forced">False</field>
        <field name="to_scan">True</field>
        <field name="required">True</field>
        <field name="clean_after_done">True</field>
        <field
            name="option_group_id"
            ref="stock_barcodes.stock_barcodes_option_group_remove_inventory"
        />
    </record>

    <record
        id="stock_barcodes_option_product_qty_remove_inventory"
        model="stock.barcodes.option"
    >
        <field name="name">Product Qty</field>
        <field name="step">3</field>
        <field name="sequence">50</field>
        <field name="field_name">product_qty</field>
        <field name="filled_default">False</field>
        <field name="forced">False</field>
        <field name="to_scan">True</field>
        <field name="required">False</field>
        <field name="clean_after_done">True</field>
        <field
            name="option_group_id"
            ref="stock_barcodes.stock_barcodes_option_group_remove_inventory"
        />
    </record>
</odoo>
