<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="hr_timesheet_sheet.res_config_settings_view_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='timesheet_sheet_review_policy']/.." position="after">
                <setting
                    string="Auto-draft Timesheet Sheets"
                    help="Check to enable Timesheet Sheet(s) auto-drafting on Timesheet altering."
                >
                    <span
                        class="fa fa-lg fa-building-o"
                        title="Values set here are company-specific."
                        role="img"
                        aria-label="Values set here are company-specific."
                        groups="base.group_multi_company"
                    />
                    <field name="timesheet_sheets_autodraft" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
